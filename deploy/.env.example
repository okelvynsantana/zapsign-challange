# =============================================================================
# Copy to deploy/.env and fill in. Never commit deploy/.env.
# =============================================================================
#
#   cp deploy/.env.example deploy/.env
#   docker compose -f deploy/docker-compose.yml up --build
#
# Values below are safe, non-secret local defaults. Real secrets are left blank
# on purpose — the stack must fail loudly rather than boot with a fake secret.

# -----------------------------------------------------------------------------
# Database (PostgreSQL 16)
# -----------------------------------------------------------------------------
POSTGRES_DB=zapsign                     # Database name created on first boot of the `db` service.
POSTGRES_USER=zapsign                   # Database role used by the backend and by migrations.
POSTGRES_PASSWORD=zapsign               # Local-only password. MUST be replaced by a Secret in k8s/prod.
POSTGRES_HOST=db                        # Compose service name. Use `localhost` when running the backend outside Compose.
POSTGRES_PORT=5432                      # In-network port. The host mapping (5433) is defined in docker-compose.yml.
# Optional convenience: if set, settings may prefer this single URL over the POSTGRES_* parts above.
DATABASE_URL=postgres://zapsign:zapsign@db:5432/zapsign

# -----------------------------------------------------------------------------
# Django
# -----------------------------------------------------------------------------
DJANGO_SECRET_KEY=                      # REQUIRED. Generate: python -c "import secrets;print(secrets.token_urlsafe(64))"
DJANGO_SETTINGS_MODULE=config.settings.prod   # `config.settings.local` for developer machines / tests.
DJANGO_DEBUG=false                      # Never `true` outside a developer machine.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend   # Comma-separated Host header allow-list.
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:4200  # Comma-separated origins allowed to call the API from a browser.

# -----------------------------------------------------------------------------
# Seed user (internal manager account, created idempotently by `manage.py seed_user`)
# -----------------------------------------------------------------------------
SEED_USERNAME=manager                   # Username for the single internal user that logs into the SPA.
SEED_PASSWORD=                          # REQUIRED for seeding. Choose a strong value; never reuse in prod.

# -----------------------------------------------------------------------------
# ZapSign gateway (see contracts/zapsign-gateway.md)
# The per-company `api_token` is NOT configured here — it is stored on the Company row.
# -----------------------------------------------------------------------------
ZAPSIGN_BASE_URL=https://sandbox.api.zapsign.com.br/api/v1  # Sandbox base URL. Swap for the production host when going live.
ZAPSIGN_TIMEOUT_SECONDS=10              # Connect/read timeout for every ZapSign call.
ZAPSIGN_VERIFY_SSL=true                 # Only disable against a local mock with a self-signed certificate.
ZAPSIGN_USE_FAKE=false                  # `true` selects FakeZapSignGateway — offline dev with no network and no token.

# -----------------------------------------------------------------------------
# AI analysis provider (see contracts/analysis-provider.md)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=                         # REQUIRED by the real provider. Leave blank when AI_USE_FAKE=true.
AI_MODEL=gpt-4o-mini                    # OpenAI model id used for summary / missing clauses / insights.
AI_TIMEOUT_SECONDS=15                   # Hard budget for the synchronous analysis call inside the request.
AI_MAX_INPUT_CHARS=60000                # Extracted PDF text is truncated to this many characters before the prompt.
AI_REGEX_FALLBACK_ENABLED=true          # Run the regex/keyword clause pass that reinforces (and can replace) LLM findings.
AI_EXPECTED_CLAUSES=                    # Comma-separated clause names. Blank = built-in pt-BR set (rescisão, foro, vigência, ...).
AI_USE_FAKE=false                       # `true` selects the deterministic fake provider — offline dev, no API key, no cost.

# -----------------------------------------------------------------------------
# PDF fetch & extraction
# -----------------------------------------------------------------------------
PDF_FETCH_TIMEOUT_SECONDS=10            # Timeout when downloading the document PDF from its URL.
PDF_MAX_BYTES=20971520                  # 20 MiB guard — larger downloads are rejected before extraction.

# -----------------------------------------------------------------------------
# Alerts (bonus)
# -----------------------------------------------------------------------------
ALERT_STALLED_DAYS=5                    # A document pending signature for more than N days is flagged as stalled.

# -----------------------------------------------------------------------------
# Outbound automation webhook (see contracts/webhook-outbound.md)
# -----------------------------------------------------------------------------
N8N_WEBHOOK_URL=                        # Blank = feature off, nothing is emitted.
N8N_WEBHOOK_SECRET=                     # Blank = no `X-Signature` header is sent.
WEBHOOK_TIMEOUT_SECONDS=5               # Timeout for the outbound POST; a failure never fails the originating request.
WEBHOOK_ON_EVERY_ANALYSIS=false         # `true` emits on every analysis, not only on risk-bearing ones.

# -----------------------------------------------------------------------------
# Public URLs
# -----------------------------------------------------------------------------
PUBLIC_BASE_URL=http://localhost:8000            # Absolute base used to build `report_url` in webhook payloads.
FRONTEND_API_BASE_URL=http://localhost:8000/api  # API base the Angular SPA calls from the browser.
