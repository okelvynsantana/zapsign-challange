# =============================================================================
# Copy to deploy/.env and fill in. Never commit deploy/.env.
# =============================================================================
#
#   cp deploy/.env.example deploy/.env
#   docker compose -f deploy/docker-compose.yml up --build
#
# Values below are safe, non-secret local defaults. Real secrets are left blank
# on purpose — the stack must fail loudly rather than boot with a fake secret.
#
# FORMAT: every comment is on its own line. Do NOT append `# ...` after a value:
# when the value is empty, Docker Compose reads the comment itself as the value,
# which silently turns blank-means-off settings ON with nonsense in them.

# -----------------------------------------------------------------------------
# Database (PostgreSQL 16)
# -----------------------------------------------------------------------------
# Database name created on first boot of the `db` service.
POSTGRES_DB=zapsign
# Database role used by the backend and by migrations.
POSTGRES_USER=zapsign
# Local-only password. MUST be replaced by a Secret in k8s/prod.
POSTGRES_PASSWORD=zapsign
# Compose service name. Use `localhost` when running the backend outside Compose.
POSTGRES_HOST=db
# In-network port. The host mapping (5433) is defined in docker-compose.yml.
POSTGRES_PORT=5432
# Optional convenience: a single URL equivalent to the POSTGRES_* parts above.
DATABASE_URL=postgres://zapsign:zapsign@db:5432/zapsign

# -----------------------------------------------------------------------------
# Django
# -----------------------------------------------------------------------------
# REQUIRED. Generate: python -c "import secrets;print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
# `config.settings.local` for developer machines / tests.
DJANGO_SETTINGS_MODULE=config.settings.prod
# Never `true` outside a developer machine.
DJANGO_DEBUG=false
# Comma-separated Host header allow-list.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
# Comma-separated origins allowed to call the API from a browser.
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:4200

# -----------------------------------------------------------------------------
# Seed user (internal manager account, created idempotently by `manage.py seed_user`)
# -----------------------------------------------------------------------------
# Username for the single internal user that logs into the SPA.
SEED_USERNAME=manager
# REQUIRED for seeding. Choose a strong value; never reuse in prod.
SEED_PASSWORD=

# -----------------------------------------------------------------------------
# ZapSign gateway (see contracts/zapsign-gateway.md)
# The per-company `api_token` is NOT configured here — it is stored on the Company row.
# -----------------------------------------------------------------------------
# Sandbox base URL. Swap for the production host when going live.
ZAPSIGN_BASE_URL=https://sandbox.api.zapsign.com.br/api/v1
# Connect/read timeout for every ZapSign call.
ZAPSIGN_TIMEOUT_SECONDS=10
# Only disable against a local mock with a self-signed certificate.
ZAPSIGN_VERIFY_SSL=true
# `true` selects FakeZapSignGateway — offline dev with no network and no token.
ZAPSIGN_USE_FAKE=false

# -----------------------------------------------------------------------------
# AI analysis provider (see contracts/analysis-provider.md)
# -----------------------------------------------------------------------------
# Required by the real provider. Leave blank to fall back to the fake provider.
OPENAI_API_KEY=
# OpenAI model id used for summary / missing clauses / insights.
AI_MODEL=gpt-4o-mini
# Hard budget for the synchronous analysis call inside the request.
AI_TIMEOUT_SECONDS=15
# Extracted PDF text is truncated to this many characters before the prompt.
AI_MAX_INPUT_CHARS=60000
# Run the regex/keyword clause pass that reinforces (and can replace) LLM findings.
AI_REGEX_FALLBACK_ENABLED=true
# Comma-separated clause labels. Blank = the built-in pt-BR set
# (objeto, prazo/vigência, rescisão, multa, foro, confidencialidade, pagamento, LGPD).
AI_EXPECTED_CLAUSES=
# `true` selects the deterministic fake provider — offline dev, no API key, no cost.
AI_USE_FAKE=false

# -----------------------------------------------------------------------------
# PDF fetch & extraction
# -----------------------------------------------------------------------------
# Timeout when downloading the document PDF from its URL.
PDF_FETCH_TIMEOUT_SECONDS=10
# 20 MiB guard — larger downloads are rejected before extraction.
PDF_MAX_BYTES=20971520

# -----------------------------------------------------------------------------
# Alerts (bonus)
# -----------------------------------------------------------------------------
# A document pending signature for more than N days is flagged as stalled.
ALERT_STALLED_DAYS=5

# -----------------------------------------------------------------------------
# Outbound automation webhook (see contracts/webhook-outbound.md)
# -----------------------------------------------------------------------------
# Blank = feature off, nothing is emitted.
N8N_WEBHOOK_URL=
# Blank = no `X-Signature` header is sent.
N8N_WEBHOOK_SECRET=
# Timeout for the outbound POST; a failure never fails the originating request.
WEBHOOK_TIMEOUT_SECONDS=5
# `true` emits on every analysis, not only on risk-bearing ones.
WEBHOOK_ON_EVERY_ANALYSIS=false

# -----------------------------------------------------------------------------
# Public URLs
# -----------------------------------------------------------------------------
# NOTE: the webhook payload's `report_url` is a RELATIVE path by contract; the
# receiver prefixes whatever base reaches the API from where it runs. There is
# deliberately no PUBLIC_BASE_URL here.
# API base the Angular SPA calls from the browser.
FRONTEND_API_BASE_URL=http://localhost:8000/api
